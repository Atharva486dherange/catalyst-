# Copy to .env.local for local development. Use a demo-* ID with the emulators.
FIREBASE_PROJECT_ID=demo-saathi
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-saathi
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Set these from your Firebase web app when implementing client sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only integration configuration. Use Secret Manager for deployed keys.
# Generate a distinct 32-byte base64 key and use the same key in both runtimes.
INVITATION_ENCRYPTION_KEY=
GEMINI_ENABLE_PRESCRIPTION_EXTRACTION=false
GEMINI_MODEL=
GEMINI_API_KEY=
ENABLE_OUTBOUND_EMAIL=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_ORIGIN=http://localhost:3000
