{
  "name": "saathi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --project demo-saathi --only firestore \"npm run test:rules:run\"",
    "test:rules:run": "vitest run --project rules",
    "test:e2e": "playwright test",
    "test:backend": "firebase emulators:exec --project demo-saathi --only auth,firestore \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-saathi --only auth,firestore",
    "emulators:functions": "npm --prefix functions run build && firebase emulators:start --project demo-saathi --only auth,firestore,functions,pubsub"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "firebase-admin": "14.5.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "^15.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
